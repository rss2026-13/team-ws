<launch>

  <arg name="params_file"
     default="$(find-pkg-share boating_school_state_machine)/boating_school_state_machine/params.yaml"/>

  <!-- Particle Filter -->
  <node pkg="localization"
        exec="particle_filter"
        name="particle_filter"
        param from="$(arg params_file)"/>

  <!-- YOLO Detector -->
  <node pkg="visual_servoing"
        exec="final_detector"
        name="final_detector"
        param from="$(arg params_file)"/>

  <!-- Homography -->
  <node pkg="visual_servoing"
        exec="traffic_light_homography"
        name="traffic_light_homography"
        param from="$(arg params_file)"/>

  <!-- Traffic Light Node -->
  <node pkg="traffic_light"
        exec="traffic_light_node"
        name="traffic_light_node"
        param from="$(arg params_file)"/>

  <!-- Trajectory Planner -->
  <node pkg="path_planning"
        exec="trajectory_planner"
        name="trajectory_planner"
        param from="$(arg params_file)"/>

  <!-- Trajectory Follower -->
  <node pkg="path_planning"
        exec="trajectory_follower"
        name="trajectory_follower"
        param from="$(arg params_file)"/>

  <!-- Parking Controller -->
  <node pkg="visual_servoing"
        exec="parking_controller"
        name="parking_controller"
        param from="$(arg params_file)"/>

  <!-- Safety Controller -->
  <node pkg="safety_controller"
        exec="safety_controller"
        name="safety_controller"
        param from="$(arg params_file)"/>

  <!-- State Machine -->
  <node pkg="boating_school_state_machine"
        exec="boating_school_state_machine"
        name="boating_school_state_machine"
        param from="$(arg params_file)"/>

</launch>
